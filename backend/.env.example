# Copy to .env. Never commit .env.

NODE_ENV=development
PORT=4000
# Interface to listen on. Use 127.0.0.1 on a server so only the reverse proxy / SSH tunnel can reach it.
HOST=0.0.0.0

# Database. Leave DATABASE_URL empty in development to use a local SQLite file (no install needed).
# Production: a PostgreSQL URL, e.g. postgres://user:password@host:5432/efalcon
DATABASE_URL=
SQLITE_FILE=./data/efalcon.sqlite

# Secrets. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Required in production; the server refuses to start without it.
JWT_SECRET=

# Browser origins allowed to call the API (comma separated), e.g. https://app.example.com
CORS_ORIGINS=http://localhost:5173

# Refresh-token cookie. Use "lax" when the dashboard and API share a site (app.example.com + api.example.com).
# "none" is needed if they are on unrelated domains; some browsers block that.
COOKIE_SAMESITE=lax

# OCPP. In production every charger must present its key (HTTP Basic, OCPP security profile 1 or 2).
OCPP_REQUIRE_AUTH=false

# Set to 1 when running behind a reverse proxy that terminates TLS.
TRUST_PROXY=0
